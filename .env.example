# Signature Motors / MOTOR configuration
# Copy to .env.local and set real values for production.

# WhatsApp number without + or spaces (e.g. 2348012345678)
NEXT_PUBLIC_WHATSAPP_NUMBER=2348000000000

# Phone number for tel: links (include +)
NEXT_PUBLIC_PHONE_NUMBER=+2348000000000

# Contact email
NEXT_PUBLIC_CONTACT_EMAIL=hello@signaturemotors.com

# Public site origin for canonical URLs and absolute OG images (optional)
# Example: https://www.signaturemotors.com
NEXT_PUBLIC_SITE_URL=
