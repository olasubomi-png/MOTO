# Neon PostgreSQL (server-only — never prefix with NEXT_PUBLIC_)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# WhatsApp (default: 2348051890334)
# NEXT_PUBLIC_WHATSAPP_NUMBER=2348051890334

# Phone (default: +2348070627688)
# NEXT_PUBLIC_PHONE_NUMBER=+2348070627688

# Contact email
# NEXT_PUBLIC_CONTACT_EMAIL=

# Public site origin for canonical URLs (optional)
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
