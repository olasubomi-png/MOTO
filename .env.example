# Tosin Signature Motors / MOTOR configuration
# Copy to .env.local for local overrides if needed.

# WhatsApp number without + or spaces (default: 2348051890334)
# NEXT_PUBLIC_WHATSAPP_NUMBER=2348051890334

# Phone for tel: links (default: +2348070627688)
# NEXT_PUBLIC_PHONE_NUMBER=+2348070627688

# Contact email
# NEXT_PUBLIC_CONTACT_EMAIL=hello@tosinsignaturemotors.com

# Public site origin for canonical URLs (optional — leave empty if unknown)
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
